# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Utilisée pour construire les liens de parrainage absolus (sinon déduite de l'host).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mistral AI — https://console.mistral.ai (ingestion d'offres)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Secret partagé pour appeler POST /api/offers/ingest depuis un script/cron externe
INGEST_API_SECRET=change-moi

# Emails (séparés par des virgules) autorisés à voir /admin/offres
ADMIN_EMAILS=toi@example.com
