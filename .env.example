# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Utilisée pour construire les liens de parrainage absolus (sinon déduite de l'host).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic Claude — https://console.anthropic.com/settings/keys (ingestion
# d'offres, découverte d'offres par recherche web, lettres de motivation,
# audit CV, matching CV↔offre, classification des réponses email --
# remplace Gemini + Mistral). Optionnelle pour les fonctionnalités qui ont un
# repli statique (staticGenerator.ts / staticAudit.ts / staticOfferFit.ts,
# zéro appel API) : jamais de page blanche pour l'utilisateur si Claude est
# en panne/quota dépassé. Obligatoire pour l'ingestion d'offres (admin) et la
# découverte automatique (cron), qui n'ont pas de repli.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Secret partagé pour appeler POST /api/offers/ingest depuis un script/cron externe
INGEST_API_SECRET=change-moi

# Emails (séparés par des virgules) autorisés à voir /admin/offres
ADMIN_EMAILS=toi@example.com

# Resend — https://resend.com/api-keys (email au parrain lors d'une inscription filleul)
RESEND_API_KEY=re_xxxxxxxxx
# Tant que votre domaine n'est pas vérifié sur Resend, les emails ne partent
# réellement que vers l'adresse de votre propre compte Resend (mode sandbox).
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optionnel : sécurise les crons Vercel (deactivate-expired-offers,
# sync-adzuna — voir vercel.json). Si définie, Vercel ajoute automatiquement
# "Authorization: Bearer $CRON_SECRET" à ses appels.
CRON_SECRET=

# Adzuna — https://developer.adzuna.com (inscription gratuite, instantanée,
# App ID + App Key visibles direct dans le dashboard). Alimente le sync
# périodique /api/cron/sync-adzuna qui ramène des milliers d'offres
# alternance/stage et retire celles qui ne réapparaissent plus.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# France Travail (ex-Pôle Emploi) — https://francetravail.io (inscription
# gratuite) : créer un compte, "Mes applications" > créer une application,
# puis l'abonner à l'API "Offres d'emploi v2" pour obtenir ces deux valeurs.
# Alimente /api/cron/sync-france-travail (ajouté le 28/09 pour dépasser
# 10 000 offres actives) -- volume très supérieur à Adzuna, gratuit sans
# limite de plan Trial. Tant que ces deux variables sont vides, ce cron
# s'ignore lui-même sans erreur (voir route.ts).
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Google OAuth Client — Google Cloud Console > APIs & Services > Identifiants.
# Le MÊME Client ID/Secret que celui déjà configuré côté Supabase (Authentication
# > Providers > Google) pour "Continuer avec Google" : Supabase gère la
# connexion, mais ces valeurs sont nécessaires ICI en plus pour que le
# backend puisse rafraîchir lui-même le token Gmail à chaque sync
# (/api/cron/sync-gmail-replies), indépendamment de la session Supabase.
# Nécessite d'ajouter le scope Gmail (https://www.googleapis.com/auth/gmail.readonly)
# à l'écran de consentement OAuth, ce qui déclenche la vérification Google
# (CASA) avant un usage en production au-delà de ~100 utilisateurs de test.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Stripe — https://dashboard.stripe.com/apikeys (abonnement Premium 7,99€/mois
# + accès à vie 39,99€ en paiement unique depuis le 27/09 (70€ avant -- un
# Price Stripe est immuable, donc un changement de prix veut dire créer un
# NOUVEAU Price et remplacer l'ID ci-dessous, jamais éditer l'ancien) --
# formule hebdomadaire à 3,50€/semaine retirée le 26/09, voir RETENTION_AUDIT.md)
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# ID du Price récurrent mensuel (Dashboard > Produits > créer "Stageio Premium" > Price
# 7,99€/mois récurrent), format price_xxxxxxxx
STRIPE_PRICE_ID=
# Optionnel : Price UNIQUE (pas récurrent) à 39,99€ sur le même produit --
# tant que non renseigné, la carte "Accès à vie" ne s'affiche pas sur /premium.
STRIPE_PRICE_ID_LIFETIME=
# Dashboard > Développeurs > Webhooks > créer un endpoint vers /api/stripe/webhook,
# événements checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid — copier le "Signing secret" (whsec_...)
STRIPE_WEBHOOK_SECRET=
