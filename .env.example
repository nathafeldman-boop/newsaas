# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Utilisée pour construire les liens de parrainage absolus (sinon déduite de l'host).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mistral AI — https://console.mistral.ai (ingestion d'offres)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Secret partagé pour appeler POST /api/offers/ingest depuis un script/cron externe
INGEST_API_SECRET=change-moi

# Emails (séparés par des virgules) autorisés à voir /admin/offres
ADMIN_EMAILS=toi@example.com

# Resend — https://resend.com/api-keys (email au parrain lors d'une inscription filleul)
RESEND_API_KEY=re_xxxxxxxxx
# Tant que votre domaine n'est pas vérifié sur Resend, les emails ne partent
# réellement que vers l'adresse de votre propre compte Resend (mode sandbox).
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optionnel : sécurise les crons Vercel (deactivate-expired-offers,
# sync-adzuna — voir vercel.json). Si définie, Vercel ajoute automatiquement
# "Authorization: Bearer $CRON_SECRET" à ses appels.
CRON_SECRET=

# Adzuna — https://developer.adzuna.com (inscription gratuite, instantanée,
# App ID + App Key visibles direct dans le dashboard). Alimente le sync
# périodique /api/cron/sync-adzuna qui ramène des milliers d'offres
# alternance/stage et retire celles qui ne réapparaissent plus.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Google OAuth Client — Google Cloud Console > APIs & Services > Identifiants.
# Le MÊME Client ID/Secret que celui déjà configuré côté Supabase (Authentication
# > Providers > Google) pour "Continuer avec Google" : Supabase gère la
# connexion, mais ces valeurs sont nécessaires ICI en plus pour que le
# backend puisse rafraîchir lui-même le token Gmail à chaque sync
# (/api/cron/sync-gmail-replies), indépendamment de la session Supabase.
# Nécessite d'ajouter le scope Gmail (https://www.googleapis.com/auth/gmail.readonly)
# à l'écran de consentement OAuth, ce qui déclenche la vérification Google
# (CASA) avant un usage en production au-delà de ~100 utilisateurs de test.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
